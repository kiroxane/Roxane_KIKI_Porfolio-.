      "css": ".ds-card{border:1px solid #d7dcd6;border-radius:12px;padding:17px 16px 16px;background:#ffffff;color:#202623;max-width:320px}.ds-card-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}.ds-card h3{font:700 20px/1.35 'Playfair Display Variable', Georgia, serif;letter-spacing:-.025em;margin:0}.ds-card a{display:inline-flex;align-items:center;gap:5px;min-height:30px;padding:5px 8px;border:1px solid #79837b;border-radius:999px;color:#294bc6;text-decoration:none;font:400 10px/1.2 'Inter Variable', 'Inter', sans-serif}.ds-card a:hover{background:#e8edff}.ds-card a:focus-visible{outline:2px solid #294bc6;outline-offset:4px;}.ds-category{color:#294bc6;font:400 10px/1.6 'Inter Variable', 'Inter', sans-serif;margin:6px 0 0}.ds-description{color:#5d665f;font:400 13px/1.6 'Inter Variable', 'Inter', sans-serif;margin:10px 0 16px}.ds-card-tag{display:inline-flex;align-items:center;gap:4px;padding:3px 6px;border-radius:999px;background:#e8edff;color:#202623;font:400 10px/1.6 'Inter Variable', 'Inter', sans-serif}.ds-card-tag svg{width:14px;height:14px}"
